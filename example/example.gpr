with "../cpuload.gpr";

project Example is

    for Languages use ("Ada");
    for Source_Dirs use ("src");
    for Object_Dir use "obj";
    for Exec_Dir use ".";
    for Main use ("example_cpu_load.adb");
    for Create_Missing_Dirs use "True";

    package Compiler is
        for Switches ("Ada") use ("-O2", "-gnat2012", "-gnatwa");
    end Compiler;

    package Binder is
        for Switches ("Ada") use ("-static");
    end Binder;

end Example;
