library project CpuLoad is

    -- The OS to compile for, picked from the target gprbuild reports
    -- Override with: gprbuild -XPJ_OS=windows
    Host_Target := project'Target;
    Host_OS := external ("OS", "");
    Default_OS := "linux";

    -- The names are the canonical ones of gprconfig
    case Host_Target is
        when "x86_64-windows" | "x86-windows"
            => Default_OS := "windows";
        when "aarch64-darwin" | "x86_64-darwin" | "x86-darwin"
            => Default_OS := "macos";
        when "x86_64-linux" | "aarch64-linux" | "arm-linux" | "armhf-linux" | "x86-linux"
            => Default_OS := "linux";
        when "x86_64-freebsd" | "aarch64-freebsd"
            => Default_OS := "freebsd";
        when others =>
            -- A name not listed above: Windows says so in its environment, anything else is taken as Linux
            case Host_OS is
                when "Windows_NT" => Default_OS := "windows";
                when others => null;
            end case;
    end case;

    type OS_Platform is ("linux", "windows", "macos", "freebsd");
    PJ_OS : OS_Platform := external ("PJ_OS", Default_OS);

    -- Code shared by every OS is in src, the body of CPU_Load.Platform for one OS in its own folder
    -- Defines is for client projects such as the example; the library itself uses Platform_Dir
    Platform_Dir := "src/linux";
    Defines := ();

    case PJ_OS is
        when "linux" =>
            Platform_Dir := "src/linux";
            Defines := ("-gnateDPJ_LINUX=True", "-gnateDPJ_WINDOWS=False",
                        "-gnateDPJ_MACOS=False", "-gnateDPJ_FREEBSD=False");
        when "windows" =>
            Platform_Dir := "src/windows";
            Defines := ("-gnateDPJ_LINUX=False", "-gnateDPJ_WINDOWS=True",
                        "-gnateDPJ_MACOS=False", "-gnateDPJ_FREEBSD=False");
        when "macos" =>
            Platform_Dir := "src/macos";
            Defines := ("-gnateDPJ_LINUX=False", "-gnateDPJ_WINDOWS=False",
                        "-gnateDPJ_MACOS=True", "-gnateDPJ_FREEBSD=False");
        when "freebsd" =>
            Platform_Dir := "src/freebsd";
            Defines := ("-gnateDPJ_LINUX=False", "-gnateDPJ_WINDOWS=False",
                        "-gnateDPJ_MACOS=False", "-gnateDPJ_FREEBSD=True");
    end case;

    -- static : libcpuload.a, linked into the client
    -- relocatable (shared) : libcpuload.so / .dll / .dylib, with the C interface
    -- static-pic : archive built position independent, for someone else's shared library
    type Library_Type_Kind is ("static", "relocatable", "static-pic");
    Library_Type : Library_Type_Kind :=
        external ("CPULOAD_LIBRARY_TYPE", external ("LIBRARY_TYPE", "static"));

    for Languages use ("Ada");
    for Library_Name use "cpuload";
    for Source_Dirs use ("src", Platform_Dir);
    for Object_Dir  use "obj/" & Library_Type;
    for Library_Dir use "lib/" & Library_Type;
    for Library_Kind use Library_Type;
    for Create_Missing_Dirs use "True";

    -- Standalone so C, Python, etc. can load it with no setup; encapsulated where gprbuild can, to carry the Ada runtime
    case Library_Type is
        when "relocatable" =>
            for Library_Interface use ("CPU_Load", "CPU_Load.C_API");

            case PJ_OS is
                when "macos" =>
                    -- gprbuild cannot encapsulate on macOS, so the library loads the Ada runtime from its own file
                    for Library_Standalone use "standard";

                    -- gprbuild 26 writes the runtime folder into the library with a space in front, which macOS never finds
                    -- The specs file records that folder instead, so the library finds the runtime without DYLD_LIBRARY_PATH
                    for Run_Path_Option use ();
                    for Library_Options use ("-specs=" & project'Project_Dir & "src/macos/ada_runtime_rpath.specs");
                when "windows" =>
                    -- The DLL itself calls EnumProcesses, so it needs psapi too; Linker_Options below only applies to clients
                    for Library_Standalone use "encapsulated";
                    for Library_Options use ("-lpsapi");
                when "linux" | "freebsd" =>
                    for Library_Standalone use "encapsulated";
            end case;

            -- The number is the ABI: bump it only when the C interface changes in an incompatible way
            case PJ_OS is
                when "linux" | "freebsd" =>
                    for Library_Version use "libcpuload.so.0";
                when others =>
                    null;
            end case;

        when others =>
            null;
    end case;

    package Linker is
        case PJ_OS is
            when "windows" =>
                --  EnumProcesses lives in psapi
                for Linker_Options use ("-lpsapi");
            when others =>
                null;
        end case;
    end Linker;

    package Compiler is
        for Switches ("Ada") use ("-O2", "-gnat2012", "-gnatwa");
    end Compiler;

    package Binder is
        for Switches ("Ada") use ("-static");
    end Binder;

end CpuLoad;
