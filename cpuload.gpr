library project CpuLoad is

    Host_Target := project'Target;

    Default_OS := "linux";
    case Host_Target is
        when "aarch64-darwin" | "arm64-darwin" | "x86_64-darwin" | "i686-darwin"
            => Default_OS := "macos";
        when "x86_64-windows64" | "x86_64-windows" | "aarch64-windows64" | "i686-windows"
            => Default_OS := "windows";
        when others
            => Default_OS := "linux";
    end case;

    --  Windows also announces itself in the environment, which settles a target name the list above does not carry
    type Host_OS_Kind is ("Windows_NT", "other");
    Host_OS : Host_OS_Kind := external ("OS", "other");

    case Host_OS is
        when "Windows_NT"
            => Default_OS := "windows";
        when "other"
            => null;
    end case;

    -- Symbols to indicate which OS to compile for
    -- Build with: gprbuild -XPJ_OS=windows
    type OS_Platform is ("linux", "windows", "macos"); --, "bsd");
    PJ_OS : OS_Platform := external ("PJ_OS", Default_OS);

    -- Default platform directory for each CPU load implementation
    Platform_Dir := "src/linux";

    -- The library itself picks its OS by the source directory above rather than by these symbols
    -- They are here for the projects that with this one, such as the example, which is one body of code for every OS and has to know which one it was built for
    Defines := ();

    case PJ_OS is
        when "linux" =>
            Platform_Dir := "src/linux";
            Defines := ("-gnateDPJ_LINUX=True", "-gnateDPJ_WINDOWS=False",
                        "-gnateDPJ_MACOS=False");
        when "windows" =>
            Platform_Dir := "src/windows";
            Defines := ("-gnateDPJ_LINUX=False", "-gnateDPJ_WINDOWS=True",
                        "-gnateDPJ_MACOS=False");
        when "macos" =>
            Platform_Dir := "src/macos";
            Defines := ("-gnateDPJ_LINUX=False", "-gnateDPJ_WINDOWS=False",
                        "-gnateDPJ_MACOS=True");
--        when "bsd" =>
--            Platform_Dir := "src/bsd";
    end case;

    -- Library type
    -- static : libCPU_Load.a, linked into the client
    -- relocatable : libCPU_Load.so / .dll / .dylib
    -- static-pic : archive built position independent, so it can itself be linked into someone else's shared library
    type Library_Type_Kind is ("static", "relocatable", "static-pic");
    Library_Type : Library_Type_Kind :=
        external ("CPULOAD_LIBRARY_TYPE", external ("LIBRARY_TYPE", "static"));

    for Languages use ("Ada");
    for Library_Name use "CPU_Load";
    for Source_Dirs use ("src", Platform_Dir);
    for Object_Dir  use "obj/" & Library_Type;
    for Library_Dir use "lib/" & Library_Type;
    for Library_Kind use Library_Type;
    for Create_Missing_Dirs use "True";

    -- The relocatable (shared) library is stand-alone: it starts itself up when loaded, so programs in other languages (C, Python, Java, Rust, etc.) can simply load it and call the functions of include/cpuload.h, with nothing else needed
    -- It is encapsulated as well where it can be, meaning it carries the Ada runtime and is one self-contained file
    case Library_Type is
        when "relocatable" =>
            for Library_Interface use ("CPU_Load", "CPU_Load.C_API");
            case PJ_OS is
                when "macos" =>
                    -- gprbuild cannot encapsulate on macOS, so the library loads the Ada runtime from its own file there
                    for Library_Standalone use "standard";
                when others =>
                    for Library_Standalone use "encapsulated";
            end case;

            case PJ_OS is
                when "linux" =>
                    for Library_Version use "libCPU_Load.so.0";
                when "windows" =>
                    -- Linker_Options below is for whoever links against this library, and it comes too late for the library itself: the DLL calls EnumProcesses, so it has to link psapi on its own
                    for Library_Options use ("-lpsapi");
                when "macos" =>
                    -- Nothing to add: the counters the library reads are in libSystem, which every program links already
                    null;
            end case;

        when others =>
            null;
    end case;

    package Linker is
        case PJ_OS is
            when "windows" =>
                --  EnumProcesses lives in psapi
                for Linker_Options use ("-lpsapi");
            when others =>
                null;
        end case;
    end Linker;

    package Compiler is
        for Switches ("Ada") use ("-O2", "-gnat2012", "-gnatwa");
    end Compiler;

    package Binder is
        for Switches ("Ada") use ("-static");
    end Binder;

end CpuLoad;
